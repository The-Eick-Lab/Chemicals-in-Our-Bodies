# 8-iso-PGF2α
gam_smooth_plot <- function(
  data,
  outcome,
  predictor,
  id_var = NULL,
  n = 200,
  ci_mult = 1.96,
  xlab = NULL,
  ylab = NULL,
  fill_color = "steelblue",
  line_color = "steelblue4"
) {

  # Capture variable names
  outcome   <- enquo(outcome)
  predictor <- enquo(predictor)
  id_var    <- enquo(id_var)

  outcome_name   <- quo_name(outcome)
  predictor_name <- quo_name(predictor)

  # Build GAM formula
  if (is.null(id_var)) {
    gam_formula <- as.formula(
      paste0(outcome_name, " ~ s(", predictor_name, ")")
    )
  } else {
    gam_formula <- as.formula(
      paste0(outcome_name, " ~ s(", predictor_name, ")")
    )
  }

  # Fit model
  gam_mod <- gam(
    formula = gam_formula,
    data = data,
    family = gaussian,
    method = "REML",
    random = if (!quo_is_null(id_var)) as.formula(
      paste0("~(1 | ", quo_name(id_var), ")")
    ) else NULL
  )

  # Create prediction grid
  newdat <- data.frame(
    x = seq(
      min(pull(data, !!predictor), na.rm = TRUE),
      max(pull(data, !!predictor), na.rm = TRUE),
      length.out = n
    )
  )
  names(newdat) <- predictor_name

  # Predictions
  pred <- predict(
    gam_mod,
    newdata = newdat,
    se.fit = TRUE
  )

  preds <- newdat %>%
    mutate(
      !!outcome_name := pred$fit,
      CI_lower = pred$fit - ci_mult * pred$se.fit,
      CI_upper = pred$fit + ci_mult * pred$se.fit
    )

  # Plot
  ggplot(preds, aes(x = !!predictor, y = !!outcome)) +
    geom_ribbon(
      aes(ymin = CI_lower, ymax = CI_upper),
      alpha = 0.15,
      fill = fill_color
    ) +
    geom_line(
      linewidth = 1,
      color = line_color
    ) +
    labs(
      x = xlab %||% predictor_name,
      y = ylab %||% outcome_name
    ) +
    theme_bw() +
    theme(
       axis.title.x = element_text(size = 28, face = "bold"),
  axis.title.y = element_text(size = 28, face = "bold"),
  axis.text.x  = element_text(size = 28),
  axis.text.y  = element_text(size = 28),
  plot.margin  = margin(1, 1, 1, 1, "cm")
    )
}

