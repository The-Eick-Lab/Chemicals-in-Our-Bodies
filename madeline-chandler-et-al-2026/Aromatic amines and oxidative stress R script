run_exposure_plots <- function(data, exposure, labels) {
  
  outcome_vars <- c(
    "iso.imp.ngml_log",
    "isom.imp.ngml_log",
    "isom.imp.new.ngml_log",
    "pgf.imp.ngml_log"
  )
  
  # TERTILE MODELS
  run_tert <- function(outcome_var) {
    tidy(
      lm(as.formula(
        paste0(
          outcome_var,
          " ~ ", exposure, "_tertile"
        )
      ), data = data),
      conf.int = TRUE
    ) %>%
      filter(grepl(paste0(exposure, "_tertile"), term)) %>%
      mutate(outcome = outcome_var)
  }
  
  tert_res <- bind_rows(lapply(outcome_vars, run_tert))
  
  # extracting numeric tertile term and matching it to label ("ampa_tertile2" gets parsed as 2 and then matched to T2 cutoff points, this helps prevent code breaks)
  tert_clean <- tert_res %>%
    mutate(
      tert_num = readr::parse_number(term),
      exposure = labels[tert_num]
    )
  tert_clean
}


